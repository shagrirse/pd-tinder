# Runtime environment for the production server (adapter-node).
# Copy to .env and adjust, or set these in the instance environment.

# Where the SQLite database lives.
DATABASE_URL=data/pd-tinder.db

# The public origin, used by adapter-node to validate form submissions.
# MUST be the full https URL. If this is unset or wrong, every form POST is
# rejected as cross-site — login, verdicts, invites, import — while pages still
# render normally. The Vite dev server ignores this, so only a real deployment
# reveals a mistake.
ORIGIN=https://pdtinder.kattokloset.com

# Maximum accepted request body. MUST be well above the applicant CSV size:
# the 2026 file is ~430KB and adapter-node's default is only 512K, which the
# Vite dev server does not enforce — so an undersized value fails in production
# only, never in local development or tests.
BODY_SIZE_LIMIT=5M

# Port the built server listens on.
PORT=3000
